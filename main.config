# Package definitions and download cache. Environment values override defaults.
# Relative overrides are resolved from the caller's working directory.
PACKAGES_BASE_DIR="${PACKAGES_BASE_DIR:-$SCRIPT_DIR/packages}"
if [[ -z "${TMP_DOWNLOAD_DIR:-}" ]]; then
    if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
        TMP_DOWNLOAD_DIR="$XDG_CACHE_HOME/dos-bootstrap/downloads"
    elif [[ -n "${HOME:-}" ]]; then
        TMP_DOWNLOAD_DIR="$HOME/.cache/dos-bootstrap/downloads"
    else
        TMP_DOWNLOAD_DIR="${TMPDIR:-/tmp}/dos-bootstrap-$UID/downloads"
    fi
fi
